    CHAT_FLOW --> DP
    DP --> PM1
    CF7 --> SE1
    SE1 --> PM2
    SE1 --> G2
    CF4 --> G1
    CF8 --> G1

    CHAT_FLOW --> AGENT_CONFIG
    AC2 --> PM1
    AC3 --> CF3

    CF6 --> TH1
    TH1 --> MCP
    MCP --> MCP_CACHE
    T6 --> F2
    F2 -- "GET /api/download/" --> BROWSER

    H1 --> SKILLS_STORE
    H2 --> CF3
    H3 --> CF7
    SE2 --> MCP_CACHE

    G2 --> SE2
    G1 --> CF5

    CF8 --> TOOL_FLAGS
    CF8 --> SKILL_FLAGS

    SKILLS_MODAL --> SKILLS_STORE
    UPLOAD_BTN --> F1 